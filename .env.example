# --- Everything is optional: the default configuration runs fully offline. ---

# Vector store ---------------------------------------------------------------
# SQLite database path (default: ./data/index.db)
#RAGQA_DB_PATH=./data/index.db
# Set to a Postgres URL to switch to the pgvector store (pip install '.[pg]')
#DATABASE_URL=postgresql://user:pass@localhost:5432/ragqa

# Where git URLs get cloned (default: ./data/repos)
#RAGQA_REPOS_DIR=./data/repos

# Embeddings ------------------------------------------------------------------
# local (default, deterministic, no keys) | openai | sbert
#RAGQA_EMBEDDINGS=local
#RAGQA_EMBED_DIM=384
#OPENAI_API_KEY=sk-...
#RAGQA_OPENAI_EMBED_MODEL=text-embedding-3-small
#RAGQA_SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Answer provider --------------------------------------------------------------
# extractive (default, offline) | anthropic | openai
#RAGQA_ANSWER_PROVIDER=extractive
#ANTHROPIC_API_KEY=sk-ant-...
#RAGQA_ANTHROPIC_MODEL=claude-sonnet-5
#RAGQA_OPENAI_MODEL=gpt-4o-mini

# Chunking ---------------------------------------------------------------------
# auto (tree-sitter when installed, else ast/regex fallback) | fallback
#RAGQA_CHUNKER=auto
